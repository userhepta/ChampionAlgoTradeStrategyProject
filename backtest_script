def rolling_mad_numba(arr, window, min_periods):
    n = len(arr)
    out = np.full(n, np.nan)

    for i in range(n):
        start = max(0, i - window + 1)
        window_data = arr[start:i + 1]
        # Drop NaNs
        window_data = window_data[~np.isnan(window_data)]

        if len(window_data) >= min_periods:
            med = np.median(window_data)
            mad = np.median(np.abs(window_data - med))
            out[i] = mad
    return out
def rolling_mad(series, window, min_periods=None):
    if min_periods is None:
        min_periods = window
    arr = series.to_numpy(dtype=np.float64)
    return pd.Series(
        rolling_mad_numba(arr, window, min_periods),
        index=series.index
    )

def create_normalize_df(backtest_df, method ='z', look_back_period = 50, volatility_filter ='hv'):

    df = pd.DataFrame()
    if method == 'z':
        df['rolling_mean'] = backtest_df['close'].rolling(look_back_period).mean()
        df['rolling_std'] = backtest_df['close'].rolling(look_back_period).std()
        df['signal'] = (backtest_df['close'] - df['rolling_mean']) / df['rolling_std']

    elif method == 'rbz':
        df['rolling_median'] = backtest_df['close'].rolling(look_back_period).median()
        df['median_abs_deviation'] = rolling_mad(backtest_df['close'], window=look_back_period)
        df['signal'] = 0.6745 * (backtest_df['close'] - df['rolling_median']) / df['median_abs_deviation']

    elif method == 'mean':
        df['rolling_mean'] = backtest_df['close'].rolling(look_back_period).mean()
        df['rolling_max'] = backtest_df['close'].rolling(look_back_period).max()
        df['rolling_min'] = backtest_df['close'].rolling(look_back_period).min()
        df['signal'] = (backtest_df['close'] - df['rolling_mean']) / (df['rolling_max'] - df['rolling_min'])

    elif method == 'rb':
        df['rolling_median'] = backtest_df['close'].rolling(look_back_period).median()
        df['rolling_25_%ile'] = backtest_df['close'].rolling(look_back_period).quantile(0.25)
        df['rolling_75_%ile'] = backtest_df['close'].rolling(look_back_period).quantile(0.75)
        df['rolling_iqr'] = df['rolling_75_%ile'] - df['rolling_25_%ile']  # interquartile range
        df['signal'] = (backtest_df['close'] - df['rolling_median']) / df['rolling_iqr']

    elif method == 'rsi':
        df['signal'] = compute_rsi(backtest_df['close'], look_back_period)

    elif method == 'mm':
        df['rolling_max'] = backtest_df['close'].rolling(look_back_period).max()
        df['rolling_min'] = backtest_df['close'].rolling(look_back_period).min()
        df['signal'] = (backtest_df['close'] - df['rolling_min']) / (df['rolling_max'] - df['rolling_min'])

    elif method == 'pctl':
        df['signal'] = backtest_df['close'].rolling(look_back_period).apply(
            lambda x: stats.percentileofscore(x, x[-1], kind='mean'), raw=True) / 100

    else:
        logger.error(f'normalization method error, model name = {method}')

    # add volatility filter
    if volatility_filter == 'hv':
        df['rolling_hv'] = compute_hv(backtest_df['close'], look_back_period)
        df['signal'] = df['signal'] * df['rolling_hv']

    # fill NaN and inf value to be 0, happen if max & min / iqr are same
    df['signal'] = df['signal'].fillna(0)
    df['signal'] = df['signal'].replace([np.inf, -np.inf], 0)

    # drop all NaN value (only ema and rsi does not have Nan value)
    if method != 'ema' or method != 'rsi':
        df = df.drop(df.index[:look_back_period - 1])

    # check if any Nan error
    while isnan(df['signal'].mean()) == True:
        look_back_period = look_back_period + 1
        logger.error('signal mean = NaN, look back period + 1 = {}', look_back_period)
        return create_normalize_df(backtest_df, method, look_back_period, volatility_filter)

    # check if any inf error
    while isinf(df['signal'].mean()) == True:
        look_back_period = look_back_period + 1
        logger.error('signal mean = inf, look back period + 1 = {}', look_back_period)
        return create_normalize_df(backtest_df, method, look_back_period, volatility_filter)

    # check if any quantile error
    while df['signal'].mean() == df['signal'].quantile(0.975):
        while df['signal'].mean() == df['signal'].quantile(0.025):
            look_back_period = look_back_period + 1
            logger.error('signal mean = quantile, look back period + 1 = {}', look_back_period)
            return create_normalize_df(backtest_df, method, look_back_period, volatility_filter)

    normalized_df = backtest_df.join(df['signal'])
    return normalized_df

def compute_hv(price_series: pd.Series, look_back_period : int = 50):
    """
    Returns a pd.Series with the historical volatility.
    """
    df = pd.DataFrame()
    df['log_return'] = np.log(price_series / price_series.shift(1))
    df['rolling_hv'] = df['log_return'].rolling(look_back_period).std()

    return df['rolling_hv']

def compute_rsi(prices, period=14):
    """
    Compute RSI exactly like TradingView, Bloomberg, and most brokers.
    Uses Wilder's RMA (Recursive Moving Average) for smoothing.

    Parameters
    ----------
    prices : list, np.array, or pd.Series
        Closing prices.
    period : int, optional
        RSI period length (default is 14).

    Returns
    -------
    pd.Series
        RSI values, same length as input, with NaN for initial periods.
    """
    prices = pd.Series(prices).astype(float)

    # Price changes
    delta = prices.diff()

    # Gains (gain) and losses (loss)
    gain = np.where(delta > 0, delta, 0.0)
    loss = np.where(delta < 0, -delta, 0.0)

    # Convert to Series
    gain = pd.Series(gain, index=prices.index)
    loss = pd.Series(loss, index=prices.index)

    # Wilder's RMA (same as TradingView's ta.rma)
    def rma(x, n):
        return x.ewm(alpha=1/n, adjust=False).mean()

    avg_gain = rma(gain, period)
    avg_loss = rma(loss, period)

    rs = avg_gain / avg_loss
    rsi = 100 - (100 / (1 + rs))

    return rsi

